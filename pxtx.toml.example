# pxtx server config. Copy to /etc/pxtx.toml (prod) or pxtx.toml next to
# pyproject.toml (dev), then edit. Every key is optional — missing keys
# fall back to built-in defaults.

[github]
# Fine-grained personal access token. Permissions: Contents: Read-only and
# Issues: Read-only, scoped to the repos under `repos`. Bumps the GitHub
# API rate limit from 60 to 5000 req/h. Leave commented to stay
# unauthenticated.
#token = "github_pat_..."

# Repos polled by `manage.py runperiodic` — one ghost draft issue per open
# github issue not already linked via a GithubRef. Add pretalx plugin repos
# here as needed. Comment out or drop the key to default to just the core
# repo.
repos = [
  "pretalx/pretalx",
  # "pretalx/pretalx-public-voting",
  # "pretalx/pretalx-pages",
  # "pretalx/pretalx-downstream",
]

# ⁂ Spec-session worker (`manage.py runworker`). The worker refuses to
# start without a checkout path; the feature stays inert until this
# section is filled in.
#[spec]
# ⁂ pretalx checkout the worker runs `claude -p` in. Must have openspec
# initialized; claude sessions are bound to this path.
#checkout_path = "/home/pxtx/pretalx"
# ⁂ Claude binary to invoke. Defaults to `claude` on PATH.
#claude_binary = "claude"
# ⁂ Model passed via --model. No fallback model on purpose: spec quality
# is the point.
#model = "fable"
# ⁂ Deployed agent settings file, passed via --settings. Note that claude
# silently ignores files that fail validation; the worker logs a warning
# when the file is missing or not valid JSON.
#settings_file = "/etc/pxtx-claude-settings.json"
# ⁂ Per-turn cost cap, passed via --max-budget-usd. Default: 5.0.
#max_budget_usd = 5.0
# ⁂ Subprocess timeout in seconds before the worker kills a claude run.
# Default: 3600 (spec turns can legitimately run 10-30 minutes).
#timeout_seconds = 3600
